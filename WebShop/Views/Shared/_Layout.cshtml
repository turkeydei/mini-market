<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mini Market</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    
    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        
        main {
            flex: 1;
        }
        
        .navbar {
            box-shadow: 0 2px 4px rgba(0,0,0,.1);
        }
        
        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
            color: #0d6efd !important;
        }
        
        .cart-badge {
            position: absolute;
            top: -8px;
            right: -8px;
            background: #dc3545;
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            font-weight: bold;
        }
        
        footer {
            background: #f8f9fa;
            padding: 20px 0;
            margin-top: 50px;
        }
    </style>
</head>
<body>
    <header class="mm-header">
        <div class="mm-header__inner container">
            <div class="mm-brand">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="mm-brand__logo">
                    <span>🛒</span>
                    <div>
                        <strong>Mini Market</strong>
                        <small>Mua sắm mỗi ngày</small>
                    </div>
                </a>
            </div>

            <form asp-controller="Home" asp-action="Index" method="get" class="mm-search d-none d-md-flex">
                <i class="bi bi-search"></i>
                <input type="text" name="keyword" value="@Context.Request.Query["keyword"]" placeholder="Tìm sản phẩm, danh mục, thương hiệu..." />
                <button type="submit">Tìm kiếm</button>
            </form>

            <nav class="mm-nav">
                <a asp-controller="Home" asp-action="Index" class="mm-nav__item">
                    <i class="bi bi-house-door"></i>
                    <span>Trang chủ</span>
                </a>
                <a asp-controller="Checkout" asp-action="Index" class="mm-nav__item">
                    <i class="bi bi-bag-check"></i>
                    <span>Giỏ hàng</span>
                    <span class="cart-badge">0</span>
                </a>
            </nav>

            <div class="mm-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="mm-user dropdown">
                        <button class="btn mm-user__trigger dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i>
                            <span>@User.Identity.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Auth" asp-action="Profile"><i class="bi bi-person"></i> Thông tin cá nhân</a></li>
                            <li><a class="dropdown-item" asp-controller="Order" asp-action="History"><i class="bi bi-clock-history"></i> Lịch sử đơn hàng</a></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="#"><i class="bi bi-gear"></i> Quản trị</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post">
                                    <button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-outline-secondary" asp-controller="Auth" asp-action="Login">
                        <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                    </a>
                    <a class="btn btn-primary" asp-controller="Auth" asp-action="Register">
                        <i class="bi bi-person-plus"></i> Đăng ký
                    </a>
                }
            </div>
        </div>
    </header>
    
    <main role="main">
        @RenderBody()
    </main>

    <footer class="border-top">
        <div class="container text-center">
            <div class="row py-4">
                <div class="col-md-4">
                    <h5>🛒 Mini Market</h5>
                    <p class="text-muted small">Mua sắm trực tuyến dễ dàng</p>
                </div>
                <div class="col-md-4">
                    <h6>Liên hệ</h6>
                    <p class="text-muted small">
                        <i class="bi bi-telephone"></i> 0123-456-789<br>
                        <i class="bi bi-envelope"></i> support@minimarket.com
                    </p>
                </div>
                <div class="col-md-4">
                    <h6>Theo dõi chúng tôi</h6>
                    <a href="#" class="text-muted me-3"><i class="bi bi-facebook" style="font-size: 1.5rem;"></i></a>
                    <a href="#" class="text-muted me-3"><i class="bi bi-instagram" style="font-size: 1.5rem;"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-youtube" style="font-size: 1.5rem;"></i></a>
                </div>
            </div>
            <div class="border-top pt-3">
                <p class="text-muted small mb-0">
                    &copy; 2025 - Mini Market. All rights reserved.
                </p>
            </div>
        </div>
    </footer>
    
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Cart Counter Script -->
    <script>
        function updateCartCount() {
            let cart = JSON.parse(localStorage.getItem('cart') || '[]');
            let totalItems = cart.reduce((sum, item) => sum + item.soLuong, 0);
            $('.cart-badge').text(totalItems);
            if (totalItems === 0) {
                $('.cart-badge').hide();
            } else {
                $('.cart-badge').show();
            }
        }
        
        $(document).ready(function() {
            updateCartCount();
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
