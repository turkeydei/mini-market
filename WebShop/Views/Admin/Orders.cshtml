@model IEnumerable<Domain.Entities.HoaDon>
@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var status = ViewBag.Status as string;
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-cart-check me-2"></i>Danh Sách Đơn Hàng</h5>
        <div>
            <a href="@Url.Action("Orders", "Admin")" class="btn btn-sm @(string.IsNullOrEmpty(status) ? "btn-primary" : "btn-outline-primary")">
                Tất Cả
            </a>
            <a href="@Url.Action("Orders", "Admin", new { status = "Pending" })" class="btn btn-sm @(status == "Pending" ? "btn-warning" : "btn-outline-warning")">
                Chờ Xử Lý
            </a>
            <a href="@Url.Action("Orders", "Admin", new { status = "Processing" })" class="btn btn-sm @(status == "Processing" ? "btn-info" : "btn-outline-info")">
                Đang Xử Lý
            </a>
            <a href="@Url.Action("Orders", "Admin", new { status = "Completed" })" class="btn btn-sm @(status == "Completed" ? "btn-success" : "btn-outline-success")">
                Hoàn Thành
            </a>
            <a href="@Url.Action("Orders", "Admin", new { status = "Cancelled" })" class="btn btn-sm @(status == "Cancelled" ? "btn-danger" : "btn-outline-danger")">
                Đã Hủy
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="ordersTable">
                <thead>
                    <tr>
                        <th>Mã ĐH</th>
                        <th>Khách Hàng</th>
                        <th>Ngày Đặt</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong>#@order.MaHD</strong></td>
                            <td>
                                @if (order.User != null)
                                {
                                    <div>@order.User.HoTen</div>
                                    <small class="text-muted">@order.User.Email</small>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>@order.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><strong>@string.Format("{0:N0}", order.TongTien) đ</strong></td>
                            <td>
                                <span class="badge bg-@(order.Status == "Completed" ? "success" : order.Status == "Pending" ? "warning" : order.Status == "Processing" ? "info" : "danger")">
                                    @order.Status
                                </span>
                            </td>
                            <td>
                                <a href="@Url.Action("OrderDetails", "Admin", new { id = order.MaHD })" class="btn btn-sm btn-primary">
                                    <i class="bi bi-eye"></i> Chi Tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#ordersTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/vi.json'
                },
                order: [[2, 'desc']]
            });
        });
    </script>
}

