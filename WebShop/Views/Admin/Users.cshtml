@model IEnumerable<Domain.Entities.User>
@{
    ViewData["Title"] = "Quản Lý Người Dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-people me-2"></i>Danh Sách Người Dùng</h5>
        <span class="badge bg-primary">@Model.Count() người dùng</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="usersTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Họ Tên</th>
                        <th>Email</th>
                        <th>Điện Thoại</th>
                        <th>Vai Trò</th>
                        <th>Địa Chỉ</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.MaUser</td>
                            <td>@user.HoTen</td>
                            <td>@user.Email</td>
                            <td>@user.DienThoai</td>
                            <td>
                                <span class="badge bg-@(user.VaiTro == "Admin" ? "danger" : "primary")">
                                    @user.VaiTro
                                </span>
                            </td>
                            <td>@(user.DiaChi ?? "N/A")</td>
                            <td>
                                <form method="post" action="@Url.Action("ToggleUserRole", "Admin", new { id = user.MaUser })" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-warning" 
                                            onclick="return confirm('Bạn có chắc muốn đổi vai trò của @user.HoTen?')">
                                        <i class="bi bi-arrow-repeat"></i> Đổi Role
                                    </button>
                                </form>
                                <form method="post" action="@Url.Action("DeleteUser", "Admin", new { id = user.MaUser })" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" 
                                            onclick="return confirm('Bạn có chắc muốn xóa @user.HoTen?')">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#usersTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/vi.json'
                },
                order: [[0, 'desc']]
            });
        });
    </script>
}

