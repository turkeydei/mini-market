@model Domain.Entities.HangHoa
@{
    ViewData["Title"] = "Sửa Sản Phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var categories = ViewBag.Categories as IEnumerable<Domain.Entities.Loai>;
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Sửa Sản Phẩm</h5>
    </div>
    <div class="card-body">
        <form asp-action="EditProduct" method="post" enctype="multipart/form-data" asp-route-id="@Model.MaHH">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaHH" />
            
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="TenHH" class="form-label">Tên Sản Phẩm <span class="text-danger">*</span></label>
                        <input asp-for="TenHH" class="form-control" required />
                        <span asp-validation-for="TenHH" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaLoai" class="form-label">Danh Mục <span class="text-danger">*</span></label>
                        <select asp-for="MaLoai" class="form-select" required>
                            <option value="">-- Chọn danh mục --</option>
                            @if (categories != null)
                            {
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.MaLoai" selected="@(Model.MaLoai == cat.MaLoai)">@cat.TenLoai</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="MaLoai" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DonGia" class="form-label">Đơn Giá <span class="text-danger">*</span></label>
                        <input asp-for="DonGia" type="number" step="0.01" class="form-control" required />
                        <span asp-validation-for="DonGia" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SoLuongTon" class="form-label">Số Lượng Tồn <span class="text-danger">*</span></label>
                        <input asp-for="SoLuongTon" type="number" class="form-control" required />
                        <span asp-validation-for="SoLuongTon" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="GiamGia" class="form-label">Giảm Giá</label>
                        <input asp-for="GiamGia" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="GiamGia" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Hình Ảnh Hiện Tại</label>
                        @if (!string.IsNullOrEmpty(Model.Hinh))
                        {
                            <div class="mb-2">
                                <img src="@Model.Hinh" alt="@Model.TenHH" style="max-width: 200px; max-height: 200px;" class="img-thumbnail" />
                            </div>
                        }
                        <label for="imageFile" class="form-label">Thay Đổi Hình Ảnh</label>
                        <input type="file" name="imageFile" id="imageFile" class="form-control" accept="image/*" />
                        <small class="text-muted">Để trống nếu không muốn thay đổi</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MoTa" class="form-label">Mô Tả</label>
                        <textarea asp-for="MoTa" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="MoTa" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="@Url.Action("Products", "Admin")" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Quay Lại
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-2"></i>Cập Nhật
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

