@model Domain.Entities.Loai
@{
    ViewData["Title"] = "Sửa Danh Mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Sửa Danh Mục</h5>
    </div>
    <div class="card-body">
        <form asp-action="EditCategory" method="post" asp-route-id="@Model.MaLoai">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaLoai" />
            
            <div class="mb-3">
                <label asp-for="TenLoai" class="form-label">Tên Danh Mục <span class="text-danger">*</span></label>
                <input asp-for="TenLoai" class="form-control" required />
                <span asp-validation-for="TenLoai" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MoTa" class="form-label">Mô Tả</label>
                <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <a href="@Url.Action("Categories", "Admin")" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Quay Lại
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-2"></i>Cập Nhật
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

