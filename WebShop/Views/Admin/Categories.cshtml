@model IEnumerable<Domain.Entities.Loai>
@{
    ViewData["Title"] = "Quản Lý Danh Mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-tags me-2"></i>Danh Sách Danh Mục</h5>
        <a href="@Url.Action("CreateCategory", "Admin")" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Thêm Danh Mục
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="categoriesTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên Danh Mục</th>
                        <th>Mô Tả</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.MaLoai</td>
                            <td><strong>@category.TenLoai</strong></td>
                            <td>@(category.MoTa ?? "N/A")</td>
                            <td>
                                <a href="@Url.Action("EditCategory", "Admin", new { id = category.MaLoai })" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <form method="post" action="@Url.Action("DeleteCategory", "Admin", new { id = category.MaLoai })" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" 
                                            onclick="return confirm('Bạn có chắc muốn xóa danh mục @category.TenLoai?')">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#categoriesTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/vi.json'
                }
            });
        });
    </script>
}

