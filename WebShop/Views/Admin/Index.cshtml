@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-2">Tổng Người Dùng</h6>
                        <h2 class="mb-0">@Model.TotalUsers</h2>
                    </div>
                    <i class="bi bi-people fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-2">Tổng Sản Phẩm</h6>
                        <h2 class="mb-0">@Model.TotalProducts</h2>
                    </div>
                    <i class="bi bi-box-seam fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-2">Tổng Đơn Hàng</h6>
                        <h2 class="mb-0">@Model.TotalOrders</h2>
                    </div>
                    <i class="bi bi-cart-check fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-2">Tổng Doanh Thu</h6>
                        <h2 class="mb-0">@string.Format("{0:N0}", Model.TotalRevenue) đ</h2>
                    </div>
                    <i class="bi bi-currency-dollar fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Đơn Hàng Gần Đây</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentOrders != null && Model.RecentOrders.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Mã ĐH</th>
                                    <th>Ngày Đặt</th>
                                    <th>Tổng Tiền</th>
                                    <th>Trạng Thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td>#@order.MaHD</td>
                                        <td>@order.NgayDat.ToString("dd/MM/yyyy")</td>
                                        <td>@string.Format("{0:N0}", order.TongTien) đ</td>
                                        <td>
                                            <span class="badge bg-@(order.Status == "Completed" ? "success" : order.Status == "Pending" ? "warning" : "secondary")">
                                                @order.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">Chưa có đơn hàng nào</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Sản Phẩm Sắp Hết Hàng</h5>
            </div>
            <div class="card-body">
                @if (Model.LowStockProducts != null && Model.LowStockProducts.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Tên Sản Phẩm</th>
                                    <th>Số Lượng Tồn</th>
                                    <th>Hành Động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in Model.LowStockProducts)
                                {
                                    <tr>
                                        <td>@product.TenHH</td>
                                        <td>
                                            <span class="badge bg-@(product.SoLuongTon < 5 ? "danger" : "warning")">
                                                @product.SoLuongTon
                                            </span>
                                        </td>
                                        <td>
                                            <a href="@Url.Action("EditProduct", "Admin", new { id = product.MaHH })" class="btn btn-sm btn-primary">
                                                <i class="bi bi-pencil"></i> Sửa
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">Tất cả sản phẩm đều đủ hàng</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Thông Tin Tổng Quan</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="alert alert-warning">
                            <i class="bi bi-hourglass-split me-2"></i>
                            <strong>Đơn Hàng Chờ Xử Lý:</strong> @Model.PendingOrders
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="alert alert-info">
                            <i class="bi bi-cart me-2"></i>
                            <strong>Tổng Đơn Hàng:</strong> @Model.TotalOrders
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="alert alert-success">
                            <i class="bi bi-currency-dollar me-2"></i>
                            <strong>Doanh Thu:</strong> @string.Format("{0:N0}", Model.TotalRevenue) đ
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

