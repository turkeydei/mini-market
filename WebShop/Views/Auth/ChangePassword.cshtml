@model WebShop.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow p-4">
                <h3 class="bi bi-lock text-center mb-4 fw-bold">
                    Đổi mật khẩu
                </h3>

                @* --- BẮT ĐẦU PHẦN HIỂN THỊ THÔNG BÁO --- *@
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @* --- KẾT THÚC PHẦN HIỂN THỊ THÔNG BÁO --- *@

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="MatKhauCu" class="form-label">Mật khẩu hiện tại</label>
                        <input asp-for="MatKhauCu" type="password" class="form-control" />
                        <span asp-validation-for="MatKhauCu" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MatKhauMoi" class="form-label">Mật khẩu mới</label>
                        <input asp-for="MatKhauMoi" type="password" class="form-control" />
                        <span asp-validation-for="MatKhauMoi" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="XacNhanMatKhau" class="form-label">Xác nhận mật khẩu</label>
                        <input asp-for="XacNhanMatKhau" type="password" class="form-control" />
                        <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary w-100 py-2">
                            <i class="bi bi-check-lg"></i> Lưu thay đổi
                        </button>

                        <div class="text-center mt-3">
                            <a asp-action="Profile" asp-controller="Auth" class="text-decoration-none text-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại hồ sơ
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}