@model WebShop.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="auth-page register-page">
    <div class="auth-card">
        <div class="auth-info">
            <h2>Tạo tài khoản mới</h2>
            <p>Chỉ mất một phút để tạo tài khoản Mini Market. Bạn sẽ có thể lưu nhiều địa chỉ giao hàng, xem lịch sử mua sắm và nhận ưu đãi độc quyền.</p>
            <ul>
                <li>Thanh toán nhanh trong một lần chạm</li>
                <li>Theo dõi đơn hàng và trạng thái giao hàng</li>
                <li>Nhận thông báo các chương trình flash-sale</li>
            </ul>
            <div class="demo-box">
                <p class="text-label">Đã có tài khoản?</p>
                <div>
                    <strong>Đăng nhập ngay</strong>
                    <span>Truy cập tất cả tính năng chỉ với một lần đăng nhập.</span>
                </div>
            </div>
        </div>

        <div class="auth-form">
            <div class="auth-form__header">
                <h3>Tạo tài khoản mới ✨</h3>
                <p>Điền thông tin bên dưới để bắt đầu mua sắm</p>
            </div>

            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger soft-card"></div>

                <div class="field-group">
                    <label asp-for="HoTen">Họ và tên</label>
                    <div class="field-control">
                        <i class="bi bi-person"></i>
                        <input asp-for="HoTen" placeholder="Nguyễn Văn A" />
                    </div>
                    <span asp-validation-for="HoTen" class="text-danger"></span>
                </div>

                <div class="field-group">
                    <label asp-for="Email">Email</label>
                    <div class="field-control">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" type="email" placeholder="example@email.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="two-columns">
                    <div class="field-group">
                        <label asp-for="MatKhau">Mật khẩu</label>
                        <div class="field-control">
                            <i class="bi bi-lock"></i>
                            <input asp-for="MatKhau" type="password" placeholder="Tối thiểu 6 ký tự" />
                        </div>
                        <span asp-validation-for="MatKhau" class="text-danger"></span>
                    </div>
                    <div class="field-group">
                        <label asp-for="XacNhanMatKhau">Xác nhận mật khẩu</label>
                        <div class="field-control">
                            <i class="bi bi-lock-fill"></i>
                            <input asp-for="XacNhanMatKhau" type="password" placeholder="Nhập lại mật khẩu" />
                        </div>
                        <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
                    </div>
                </div>

                <div class="field-group">
                    <label asp-for="DienThoai">Số điện thoại</label>
                    <div class="field-control">
                        <i class="bi bi-telephone"></i>
                        <input asp-for="DienThoai" placeholder="0123456789" />
                    </div>
                    <span asp-validation-for="DienThoai" class="text-danger"></span>
                </div>

                <div class="field-group">
                    <label asp-for="DiaChi">Địa chỉ</label>
                    <div class="field-control">
                        <i class="bi bi-geo-alt"></i>
                        <textarea asp-for="DiaChi" rows="2" placeholder="123 Đường ABC, Quận XYZ"></textarea>
                    </div>
                </div>

                <div class="two-columns">
                    <div class="field-group">
                        <label asp-for="GioiTinh">Giới tính</label>
                        <div class="field-control">
                            <i class="bi bi-gender-ambiguous"></i>
                            <select asp-for="GioiTinh">
                                <option value="">-- Chọn --</option>
                                <option value="0">Nam</option>
                                <option value="1">Nữ</option>
                            </select>
                        </div>
                    </div>
                    <div class="field-group">
                        <label asp-for="NgaySinh">Ngày sinh</label>
                        <div class="field-control">
                            <i class="bi bi-calendar"></i>
                            <input asp-for="NgaySinh" type="date" />
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-primary-full">Tạo tài khoản</button>
            </form>

            <div class="form-footer">
                <span>Đã có tài khoản?</span>
                <a asp-action="Login">Đăng nhập ngay</a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
