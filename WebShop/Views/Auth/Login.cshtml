@model WebShop.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-page login-page">
    <div class="auth-card">
        <div class="auth-info">
            <h2>Mini Market</h2>
            <p>Đăng nhập để tiếp tục theo dõi đơn hàng, thanh toán nhanh chóng và nhận thông báo ưu đãi được cá nhân hóa dành riêng cho bạn.</p>
            <ul>
                <li>Quản lý lịch sử giao dịch và địa chỉ giao hàng</li>
                <li>Theo dõi trạng thái đơn hàng theo thời gian thực</li>
                <li>Nhận mã giảm giá phù hợp sở thích</li>
            </ul>
            <div class="demo-box">
                <p class="text-label">Đăng nhập nhanh</p>
                <div>
                    <strong>Admin</strong>
                    <span>admin@minimarket.com / Admin@123</span>
                </div>
                <div>
                    <strong>Customer</strong>
                    <span>nguyenvana@example.com / Customer@123</span>
                </div>
            </div>
        </div>

        <div class="auth-form">
            <div class="auth-form__header">
                <h3>Chào mừng quay lại 👋</h3>
                <p>Hãy đăng nhập để tiếp tục mua sắm</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success soft-card">
                    <i class="bi bi-check-circle-fill"></i>
                    @TempData["SuccessMessage"]
                </div>
            }

            <form asp-action="Login" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger soft-card"></div>

                <div class="field-group">
                    <label asp-for="Email">Email</label>
                    <div class="field-control">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" type="email" autocomplete="email" placeholder="name@email.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="field-group">
                    <label asp-for="MatKhau">Mật khẩu</label>
                    <div class="field-control">
                        <i class="bi bi-lock"></i>
                        <input asp-for="MatKhau" type="password" autocomplete="current-password" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                </div>

                <div class="field-inline">
                    <label class="remember-me">
                        <input asp-for="RememberMe" type="checkbox" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                    <a asp-action="ForgotPassword">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn-primary-full">Đăng nhập</button>
            </form>

            <div class="form-footer">
                <span>Chưa có tài khoản?</span>
                <a asp-action="Register">Đăng ký ngay</a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
