@model Domain.Entities.ProductReview
@{
    ViewData["Title"] = "Viết Đánh Giá";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var productId = ViewBag.ProductId as int?;
    var productName = ViewBag.ProductName as string;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-star-fill"></i> Viết Đánh Giá</h4>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h5>@productName</h5>
                        <a href="@Url.Action("Details", "Product", new { id = productId })" class="text-muted">
                            <i class="bi bi-arrow-left"></i> Quay lại trang sản phẩm
                        </a>
                    </div>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaHH" value="@productId" />

                        <div class="mb-4">
                            <label class="form-label">Đánh Giá (Sao) <span class="text-danger">*</span></label>
                            <div class="rating-input">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    <input type="radio" asp-for="Rating" value="@i" id="rating@i" class="d-none" />
                                    <label for="rating@i" class="star-label">
                                        <i class="bi bi-star-fill"></i>
                                    </label>
                                }
                            </div>
                            <span asp-validation-for="Rating" class="text-danger"></span>
                            <div class="mt-2">
                                <small class="text-muted">Chọn số sao từ 1 đến 5</small>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Comment" class="form-label">Nhận Xét</label>
                            <textarea asp-for="Comment" class="form-control" rows="5" 
                                      placeholder="Chia sẻ trải nghiệm của bạn về sản phẩm này..."></textarea>
                            <span asp-validation-for="Comment" class="text-danger"></span>
                            <small class="text-muted">Tối đa 2000 ký tự</small>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Details", "Product", new { id = productId })" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Hủy
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Gửi Đánh Giá
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rating-input {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 5px;
    }
    
    .star-label {
        font-size: 2rem;
        color: #ddd;
        cursor: pointer;
        transition: color 0.2s;
    }
    
    .star-label:hover,
    .star-label:hover ~ .star-label {
        color: #ffc107;
    }
    
    input[type="radio"]:checked ~ .star-label,
    input[type="radio"]:checked ~ .star-label ~ .star-label {
        color: #ffc107;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Update rating display khi chọn
        $('input[type="radio"][name="Rating"]').change(function() {
            var rating = $(this).val();
            console.log('Selected rating:', rating);
        });
    </script>
}

